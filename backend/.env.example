# Server Configuration
PORT=5000
NODE_ENV=development
# Timezone for the application (UTC-6 = Central Standard Time)
TZ=Etc/GMT+6

# Database Configuration
# The app uses an embedded SQLite database - no database server to install.
# The file is created (schema + sample data) on first start. Defaults to backend/data/zoo.db.
# Relative paths are resolved from the backend/ folder. Use ":memory:" for a throwaway database.
# Run `npm run db:reset` to rebuild it from database/zoo_schema.sql and database/seed_data.sql.
# DB_PATH=./data/zoo.db

# JWT Configuration
# SECURITY: Generate a secure JWT secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit your real JWT secret to version control
JWT_SECRET=generate_a_secure_random_secret_key_using_command_above
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000


# Email mode:
#   "none"     (default) emails are not sent and nothing needs the network
#   "ethereal" fake inbox for testing - needs internet access (view mail at https://ethereal.email/)
#   "api"      Brevo API (production) - needs BREVO_API_KEY
#   "smtp"     Brevo SMTP
MAIL_SERVICE="none"
BREVO_API_KEY="BREVOKEYHERE"
VERIFIED_SENDER_EMAIL="EMAIL"

# Email Logging (set to "true" to see detailed email logs - WARNING: slow in WSL)
ENABLE_EMAIL_LOGGING="false"
