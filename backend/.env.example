# Server Configuration
PORT=5000
NODE_ENV=development
# Timezone for the application (UTC-6 = Central Standard Time)
TZ=Etc/GMT+6

# Database Configuration
# Replace with your actual database credentials
# For Railway deployment, these will be provided in your project settings
DB_HOST=your-database-host.railway.app
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password_here
DB_NAME=zoo_database

# JWT Configuration
# SECURITY: Generate a secure JWT secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit your real JWT secret to version control
JWT_SECRET=generate_a_secure_random_secret_key_using_command_above
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000


# Current mode: "ethereal" for test, "brevo" for production
MAIL_SERVICE="ethereal"
BREVO_API_KEY="BREVOKEYHERE"
VERIFIED_SENDER_EMAIL="EMAIL"
